#!/bin/sh
# commit-msg — enforce "type: description", no @ prefix
# Edit the type list at gwork.json → commit.types (no need to touch this file)
MSG=$(head -1 "$1")
case "$MSG" in
  @*) echo "commit-msg: must not start with @ — use type: description" >&2; exit 1 ;;
esac
# Let git-generated messages through (merge/revert/fixup/squash) — their format is not ours to enforce
case "$MSG" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac
DEFAULT_TYPES='feat|fix|chore|refactor|docs|test|perf|style|ci'
# Guarded/non-interactive git runners can expose a narrower PATH than the login shell
# (found in an installed repo): resolve node once, fail loud if it is missing.
NODE_BIN=$(command -v node 2>/dev/null || true)
if [ -z "$NODE_BIN" ] && [ -x "$HOME/.local/bin/node" ]; then
  NODE_BIN="$HOME/.local/bin/node"
fi
if [ -z "$NODE_BIN" ]; then
  echo "commit-msg: node is required to read gwork.json" >&2
  exit 1
fi
# No gwork.json = defaults · present but unparseable = block (broken config must never be silent)
TYPES=$("$NODE_BIN" -p "(()=>{try{const c=require(process.cwd()+'/gwork.json');const t=c.commit&&c.commit.types;return Array.isArray(t)&&t.length?t.join('|'):''}catch(e){return e.code==='MODULE_NOT_FOUND'?'':'__BAD__'}})()") || {
  echo "commit-msg: node failed to run — cannot read gwork.json (broken config must never be silent)" >&2; exit 1
}
if [ "$TYPES" = "__BAD__" ]; then
  echo "commit-msg: cannot parse gwork.json — fix the config before committing" >&2; exit 1
fi
[ -z "$TYPES" ] && TYPES="$DEFAULT_TYPES"
echo "$MSG" | grep -qE "^($TYPES)(\([^)]+\))?: .+" || {
  echo "commit-msg: format must be 'type: description' (types: $TYPES)" >&2
  exit 1
}
