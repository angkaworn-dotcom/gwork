#!/bin/sh
# pre-commit — forbidden patterns (gwork.json → forbidden) are refused at the commit that adds
# them, instead of surfacing several commits later at push. Only check F runs here, against the
# index; the task-log checks stay in pre-push, where a finished unit of work is judged.
[ -f scripts/tasklog-check.mjs ] || exit 0
NODE_BIN=$(command -v node 2>/dev/null || true)
if [ -z "$NODE_BIN" ] && [ -x "$HOME/.local/bin/node" ]; then
  NODE_BIN="$HOME/.local/bin/node"
fi
if [ -z "$NODE_BIN" ]; then
  echo "pre-commit: node is required for repository checks" >&2
  exit 1
fi
"$NODE_BIN" scripts/tasklog-check.mjs --staged || {
  echo "[pre-commit] BLOCKED — unstage or fix the lines above" >&2
  exit 1
}
