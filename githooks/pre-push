#!/bin/sh
# pre-push — a real block, not a polite request (install: git config core.hooksPath githooks)
# Edit the check list at gwork.json → prepush (array of commands — run in order, any failure blocks the push)
set -e
# Every check below reads the working tree / HEAD. A pushed commit that is neither HEAD nor
# already on a remote would go out unchecked (`git push origin other-branch`) — block it.
# git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line per pushed ref.
if [ ! -t 0 ]; then
  HEAD_SHA=$(git rev-parse --verify --quiet HEAD || echo none)
  while read -r lref lsha _rref _rsha; do
    case "$lsha" in ''|*[!0]*) ;; *) continue ;; esac # all zeros = ref deletion
    c=$(git rev-parse --verify --quiet "$lsha^{commit}") || continue # peels annotated tags; non-commit = nothing to check
    [ "$c" = "$HEAD_SHA" ] && continue
    [ -n "$(git for-each-ref --count=1 --contains "$c" refs/remotes)" ] && continue # nothing new leaves the machine
    echo "[pre-push] BLOCKED — $lref is not the checked-out commit, so the checks cannot vouch for it. Check it out and push from there." >&2
    exit 1
  done
fi
# Guarded/non-interactive git runners can expose a narrower PATH than the login shell
# (found in an installed repo): resolve node once, fail loud if it is missing.
NODE_BIN=$(command -v node 2>/dev/null || true)
if [ -z "$NODE_BIN" ] && [ -x "$HOME/.local/bin/node" ]; then
  NODE_BIN="$HOME/.local/bin/node"
fi
if [ -z "$NODE_BIN" ]; then
  echo "[pre-push] BLOCKED — node is required for repository checks" >&2
  exit 1
fi
NODE_DIR=${NODE_BIN%/*}
case ":$PATH:" in
  *":$NODE_DIR:"*) ;;
  *) PATH="$NODE_DIR:$PATH"; export PATH ;; # so the gwork.json prepush commands find it too
esac
# sentinel (if installed): the enforcement machinery itself must match the owner snapshot
SENTINEL="${GWORK_HOME:-$HOME/.gwork}/bin/gwork-sentinel.mjs"
if [ -f "$SENTINEL" ]; then
  "$NODE_BIN" "$SENTINEL" verify --repo "$(pwd)" || {
    echo "[pre-push] BLOCKED — gwork-sentinel found tampered enforcement state (owner: node scripts/gwork-sentinel.mjs update)" >&2
    exit 1
  }
fi
CMDS=$("$NODE_BIN" -e "let c={};try{c=require(process.cwd()+'/gwork.json')}catch(e){if(e.code!=='MODULE_NOT_FOUND'){console.error('pre-push: cannot parse gwork.json — '+e.message);process.exit(1)}};(Array.isArray(c.prepush)&&c.prepush.length?c.prepush:['npx tsc --noEmit','node scripts/tasklog-check.mjs']).forEach(x=>console.log(x))")
printf '%s\n' "$CMDS" |
while IFS= read -r cmd; do
  [ -n "$cmd" ] || continue
  echo "[pre-push] $cmd"
  eval "$cmd" </dev/null
done
echo "[pre-push] OK"
